    "inputContract": "Caller supplies bounded sanitized event-attribute strings, header-derived column groups, current source-signature parameter names, and separately classified date/instructor/filter metadata",
    "parserGrammar": "One allowlisted call; optional same-line return and final semicolon; quoted decimal strings or canonical unquoted safe integers only; no escapes, comments, expressions, line break after return, or additional statements",
    "identifierHandling": "Quoted decimal identifiers preserve exact strings and leading zeros up to the bounded length; unquoted numerals must match 0|[1-9][0-9]* and be lexically at most 9007199254740991. No numeric ID conversion; zero-only core identifiers are unresolved placeholders.",
    "resolution": "Require onAttn/onFoPrg/onFoHw/onFoMm exactly once with current_progress grouping, matching current source signatures and identical i/course_seq/stu_pri_no/record_seq/cm_seq tuples",
    "priorProgress": "openHomeWorkRate requires previous_progress grouping and remains a separate record binding even when cm_seq matches",
    "report": "report_seq is distinct from record_seq; corroborate only shared student/record/cm keys; never infer delivery",
    "context": "View-date comparison, same-page principal equality and empty placeholders are summarized separately from row identity; none establishes occurrence date, server ownership, record absence or completed lesson",
    "executionCapabilitiesAdded": [],
    "catalogOrRegistryChanged": false
  },
