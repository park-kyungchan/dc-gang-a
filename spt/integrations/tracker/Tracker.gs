  for(const p of plans){if(!p.row[10]){pkAppendLog_('보강ID발급예정',PK_OPS.CALENDAR,'K'+(22+p.i),'보강ID','',p.id,'DB 저장 재시도에 같은 ID 사용','처리중',p.row[0],'자동화');s.getRange(22+p.i,11).setValue(p.id);SpreadsheetApp.flush();if(s.getRange(22+p.i,11).getValue()!==p.id)throw new Error('보강ID 저장 확인 실패.');}pkUpsert_(PK_OPS.MAKEUP_DB,p.id,p.record,'보강저장',p.row[0]);}
