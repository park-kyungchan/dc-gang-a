function pkActivate_(sheetName, cellA1) {
  const ss = SpreadsheetApp.getActive();
  const sheet = pkSheet_(sheetName);
  ss.setActiveSheet(sheet);
  sheet.setActiveRange(sheet.getRange(cellA1));
}

function pkSaveStudent() {
  const lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    const sheet = pkSheet_(PK_OPS.STUDENTS);
    const form = {
      name: String(sheet.getRange('B8').getValue()).trim(),
      school: String(sheet.getRange('D8').getValue()).trim(),
      grade: String(sheet.getRange('F8').getValue()).trim(),
      className: String(sheet.getRange('H8').getValue()).trim(),
      part: String(sheet.getRange('J8').getValue()).trim(),
      firstDate: sheet.getRange('L8').getValue(),
      book1: String(sheet.getRange('N8').getValue()).trim(),
      book2: String(sheet.getRange('P8').getValue()).trim(),
      status: String(sheet.getRange('R8').getValue()).trim() || '재원',
      note: String(sheet.getRange('T8').getValue()).trim()
    };
    const missing = [];
    if (!form.name) missing.push('학생명');
    if (!form.school) missing.push('학교');
    if (!form.grade) missing.push('학년');
    if (!form.className) missing.push('수업반');
    if (!form.part) missing.push('부');
    if (!(form.firstDate instanceof Date) || isNaN(form.firstDate)) missing.push('첫수업');
    if (!form.book1) missing.push('교재 1');
    if (missing.length) {
      SpreadsheetApp.getUi().alert('입력 확인', '필수 항목: ' + missing.join(', '), SpreadsheetApp.getUi().ButtonSet.OK);
      return;
    }

    const names = sheet.getRange('C14:C113').getDisplayValues().flat().map(String);
    pkValidateProfile_(form);
    const blankIndex = names.findIndex(v => !v.trim());
    if (blankIndex < 0) {
      SpreadsheetApp.getUi().alert('등록 공간 부족', '학생 목록 100행을 모두 사용했습니다. 행 확장이 필요합니다.', SpreadsheetApp.getUi().ButtonSet.OK);
      return;
    }
    const row = 14 + blankIndex;
    const studentId = pkNextStudentId_(sheet);
    const today = pkDateOnly_(new Date());
    const first = pkDateOnly_(form.firstDate);
    const stage = first > today ? '첫수업 예정' : '수업 진행';
    const nextAction = first > today ? Utilities.formatDate(first, Session.getScriptTimeZone(), 'M/d') + ' 첫수업' : '다음 수업 기록';
    const recent = first > today ? '첫수업 전' : '미입력';

    pkAppendLog_('학생등록예정',PK_OPS.STUDENTS,'A'+row+':U'+row,'프로필','',JSON.stringify(form),'입력폼 등록','처리중',studentId,'자동화');
    sheet.getRange(row, 1, 1, 7).setValues([[
      studentId, form.status, form.name, form.school, form.grade, form.className, form.part
    ].map(pkLiteral_)]);
    sheet.getRange(row, 10, 1, 3).setValues([[form.firstDate, form.book1, form.book2].map(pkLiteral_)]);
    sheet.getRange(row, 15, 1, 5).setValues([['', stage, nextAction, recent, '해당없음']]);
    sheet.getRange(row, 21).setValue(pkLiteral_(form.note));
    pkAppendLog_('학생등록', PK_OPS.STUDENTS, 'A' + row + ':U' + row, '프로필', '', JSON.stringify(form), '학생 등록폼 저장', '확인', studentId, '자동화');
    sheet.getRangeList(['B8', 'D8', 'F8', 'H8', 'J8', 'L8', 'N8', 'P8', 'T8']).clearContent();
    sheet.getRange('R8').setValue('재원');
    SpreadsheetApp.getActive().toast(form.name + ' 학생을 ' + studentId + '로 등록했습니다.', '박경찬 운영', 5);
  } finally {
    lock.releaseLock();
  }
}

function pkStartToday(){if(ptIsActive_())ptOpenToday();else pkLoadDate_(new Date());}
function pkSaveToday(){
 const lock=LockService.getScriptLock();lock.waitLock(10000);
 try{
  const s=pkSheet_(PK_OPS.TODAY),date=s.getRange('C5').getValue(),state=pkState_(),rows=s.getRange('A10:U39').getValues();
  if(!state||state.date!==pkDay_(date))throw new Error('날짜와 입력판이 연결되지 않았습니다. 미입력을 확인한 후 메뉴의 선택 날짜 불러오기를 사용하세요.');
  if(rows.some((r,i)=>pkHash_(pkIdentity_(r))!==state.identities[i]))throw new Error('학생·교재 또는 행 순서가 변경되어 저장을 중단했습니다. 입력을 보존했습니다.');
  const attDb=pkRows_(PK_OPS.ATTENDANCE_DB,14), learnDb=pkRows_(PK_OPS.LEARNING_DB,16),mkDb=pkRows_(PK_OPS.MAKEUP_DB,15),plans=[];
  const queue=pkSheet_(PK_OPS.CALENDAR).getRange('A22:K121').getValues();let required=0;
  rows.forEach((r,i)=>{
    if(!r[1]){if(pkManual_(r).some(v=>v!==''))throw new Error('학생ID 없는 입력이 있습니다: '+(i+10));return;}
    if(!pkManual_(r).some(v=>v!==''))return;
    pkValidateToday_(r);const parts=String(r[3]).split('·').map(v=>v.trim()),session=pkSessionId_(date,parts[0],parts[1]);
    if(!state.versions||state.versions[i]!==pkDbVersion_(session,r[1],attDb,learnDb))throw new Error(r[2]+': 불러온 뒤 저장 원본이 변경되었습니다. 최신 기록을 확인하세요. 입력은 보존됩니다.');
    const existing=attDb.filter(a=>a[1]===session&&a[3]===r[1]);if(existing.length>1)throw new Error('중복 출결 레코드: '+r[2]);
    const old=existing[0],id=old?old[0]:'ATT-'+session+'-'+r[1];
    if(old&&old[5]!==r[4]&&((r[4]==='결석'&&learnDb.some(l=>l[1]===session&&l[3]===r[1]))||(old[5]==='결석'&&mkDb.some(m=>m[1]===id&&m[7]!=='취소'))))throw new Error(r[2]+': 연결된 학습·보강이 있는 출결 정정입니다. 연결 이력을 먼저 확인하세요.');
    if(r[4]==='결석'&&!queue.some(q=>q[0]===id))required++;
    plans.push({r,i,parts,session,id});
  });
  if(required>queue.filter(r=>!r[0]&&!r[1]).length)throw new Error('보강 입력표에 빈 행이 부족해 아무 기록도 저장하지 않았습니다.');
  if(pkHash_(rows)!==pkHash_(s.getRange('A10:U39').getValues()))throw new Error('저장 준비 중 입력이 바뀌었습니다. 다시 저장하세요.');
  for(const p of plans){const {r,i,parts,id}=p;const session=pkEnsureSession_(date,parts[0],parts[1]),now=new Date(),actor=pkActor_();
    pkUpsert_(PK_OPS.ATTENDANCE_DB,id,[id,session,date,r[1],r[2],r[4],r[5],r[6]||'해당없음',r[4]==='결석'?'보강조율':'없음',now,now,r[17],actor,PK_OPS.TODAY+'!A'+(i+10)+':U'+(i+10)],'출결저장',r[1]);
    if(r[4]==='결석')pkEnsureMakeupQueue_(id,r[1],r[2],date,r[5],r[6]);
    else for(const [book,pi,hi,si,ei,ni] of [[r[7],8,9,13,14,15],[r[10],11,12,18,19,20]])if(book&&[pi,hi,si,ei,ni].some(k=>r[k]!==''))pkSaveLearning_('', '', session,date,r[1],r[2],book,r[pi],r[hi],r[si],r[ei],r[ni],r[17],actor);
    if(pkHash_(pkManual_(s.getRange(i+10,1,1,21).getValues()[0]))!==pkHash_(pkManual_(r)))throw new Error('저장 중 입력이 변경되었습니다. 저장된 부분을 이력에서 확인 후 다시 저장하세요.');
    s.getRange(i+10,1).setValue(true);
    state.hashes[i]=pkHash_(pkManual_(r));state.versions[i]=pkDbVersion_(session,r[1],pkRows_(PK_OPS.ATTENDANCE_DB,14),pkRows_(PK_OPS.LEARNING_DB,16));PropertiesService.getDocumentProperties().setProperty('PK_TODAY_V2',JSON.stringify(state));
  }
  pkAppendLog_('오늘저장완료',PK_OPS.TODAY,'A10:U39','저장학생수','',plans.length,'검증된 입력 저장','확인','','자동화');
  SpreadsheetApp.getActive().toast(plans.length+'명 저장 및 감사 기록 확인 완료','박경찬 운영',6);
 }catch(error){SpreadsheetApp.getActive().toast('저장 완료되지 않았습니다. '+error.message,'확인 필요',10);throw error;}finally{SpreadsheetApp.flush();lock.releaseLock();}
}
