section>';}\nfunction summaryPanel(s){const r=latestReview(s.id),prior=priorReview(s.id),a=data.attendance.find(x=>x.studentId===s.id&&x.date===classDate);return '<section class=\"panel\"><div class=\"panelhead\"><div><h2>'+esc(s.name)+' <span class=\"tag\">'+esc(s.grade)+'</span></h2><div class=\"small\">'+esc(s.className||'수업반 미확인')+' '+esc(s.part)+' · '+esc(s.school||'학교 미확인')+'</div></div><button class=\"quiet\" data-action=\"profile\">프로필</button></div><div class=\"toolbar\"><a class=\"button primary\" href=\"'+notebookLink(s.id)+'\" target=\"_blank\" rel=\"noopener\">아이폰 기록장 · 활동 배정 ↗</a><button data-action=\"attendance\">출결 '+esc(a?.status||'입력')+'</button><button data-action=\"review-form\">상세 진도·숙제 검토</button></div><div style=\"margin-top:12px\">'+s.books.map(b=>'<div class=\"bookrow\"><div><b>'+esc(b.book.name)+'</b><div class=\"small\">'+(b.confirmed?b.confirmed+'쪽 교사 확인':'교사 확인 범위 미확인')+'</div></div><div><p>'+esc(b.focus.detail||(b.flat.find(u=>u.id===b.focus.unitId)?.name)||'실제 시작 범위를 확인해 주세요')+(b.focus.page?' · '+b.focus.page+'쪽':'')+'</p><span class=\"small\">'+esc(b.last?.data.nextAction||'다음 확인 기록 없음')+'</span></div><button data-action=\"book-progress\" data-value=\"'+b.book.id+'\">진도 기록</button></div>').join('')+'</div>'+(prior?.data.next?'<details class=\"metric-details\"><summary>이전 수업의 다음 확인 · '+esc(prior.date)+'</summary><p>'+esc(prior.data.next)+'</p><p class=\"hint\">이번 수업에서 이어갈 내용은 직접 배정하거나 마감의 다음 확인에 남기세요.</p></details>':'')+(r?'<div class=\"note\">오늘 상세 기록 저장됨 · '+esc(r.data.noHomework?'숙제 없음':r.data.homework+' · '+r.data.due)+(r.current?'':'\\n이후 진도 기록이 바뀌었습니다. 리포트는 다시 대조하세요.')+'</div>':'')+'</section>';}\nfunction dashboard(s,b){return studentCards()+summaryPanel(s)+(formKind?formPanel(s,b):'<div class=\"grid2\"><section class=\"panel\"><h3>이번 만남에 확인할 일</h3>'+s.books.map(x=>'<p><b>'+esc(x.book.name)+'</b><br>'+esc(x.last?.data.unresolved||x.last?.data.nextAction||'확인할 내용이 아직 기록되지 않았습니다.')+'</p>').join('')+'<p class=\"hint\">수업 중 활동 배정·학생 전환·녹음은 아이폰 기록장에서 이어집니다.</p></section><section class=\"panel\"><h3>출결 · 보강</h3>'+studentAttendance(s)+'<div class=\"line\"></div><button data-action=\"nav\" data-value=\"calendar\">일정 확인</button></section></div>');}\nfunction progressView(s,b){return '<section class=\"panel\"><div class=\"panelhead\"><div><h2>'+esc(s.name)+'의 교재별 진도</h2><div class=\"small\">완료 확인과 재학습 기록은 구분됩니다.</div></div><button data-action=\"review-form\">상세 진도·숙제 검토</button></div>'+bookTabs(s)+(b?focus(b)+'<details class=\"metric-details\"><summary>완료율과 집계 근거 보기</summary>'+metrics(b)+'<p class=\"hint\">'+esc(b.book.basis||'집계 근거 미확인')+' · '+esc(b.book.source||'목차 출처 미확인')+'</p>'+(!b.baselineKnown?'<p class=\"note\">이전 완료 범위 미확인입니다. 시작 쪽 앞을 자동 완료하지 않습니다.</p>':'')+'</details>':'<p>배정 교재 없음</p>')+'</section>'+(formKind?formPanel(s,b):'<div class=\"grid2\"><section class=\"panel\"><h3>목차와 실제 확인 범위</h3>'+legend()+(b?unitTree(b):'')+'</section><section class=\"panel\"><h3>학습·재확인 이력</h3>'+(b?history(b):'')+'</section></div>');}\nfunction reviewView(s){const list=classEntries(classDate).map(x=>x.student).filter(x=>reviewScope==='all'||x.part===reviewScope||reviewScope==='보강'&&data.makeups.some(m=>m.studentId===x.id&&m.date===classDate&&['확정','완료'].includes(m.status)));const extra=data.students.filter(x=>latestReview(x.id)&&!list.some(s=>s.id===x.id)&&(reviewScope==='all'||x.part===reviewScope));return '<section class=\"panel\"><div class=\"panelhead\"><div><h3>검토할 수업</h3><p class=\"hint\">각 부가 끝난 뒤 검토하거나 하루 전체를 모아 보세요.</p></div><label for=\"review-filter\" class=\"screen-reader\">검토 범위</label><select id=\"review-filter\" style=\"width:165px\">'+[['1부','1부 수업'],['2부','2부 수업'],['보강','보강 수업'],['all','하루 전체']].map(x=>option(x[0],x[1],reviewScope)).join('')+'</select></div><div class=\"toolbar\"><button data-action=\"import\">아이폰 확정 내용 가져오기</button><button data-action=\"review-form\">'+esc(s.name)+' 마감 작성</button><a class=\"button\" href=\"'+notebookLink(s.id,'review')+'\" target=\"_blank\" rel=\"noopener\">목차·활동·학원 일지 검토 ↗</a></div><p class=\"hint\">Sheet 저장과 학원 DB 입력은 별개입니다. SPT에서 같은 학생·수업일의 200자 공개 일지를 검토·입력하세요. 학생별 리포트 저장과 일괄발송은 선생님이 직접 합니다.</p></section>'+(formKind==='import'?importPanel():formKind?formPanel(s,book()):[...list,...extra].map(x=>{const r=latestReview(x.id),d=r?.data;return '<section class=\"panel review-student '+(r?'confirmed':'')+'\"><div class=\"panelhead\"><h3>'+esc(x.name)+' · '+esc(x.part)+'</h3><span class=\"tag '+(d?.reportChecked&&r.current?'teal':'amber')+'\">'+(d?.reportChecked&&r.current?d.transferredAt?'전송 완료 직접 표시':'문안 대조함':r?'문안 검토 필요':'마감 전')+'</span></div>'+(d?reviewFacts(d):'<p class=\"hint\">오늘 실제 진도와 다음 숙제 범위·기한을 확정해 주세요.</p>')+(!r?.current&&r?'<p class=\"notice\">마감 이후 학습 기록이 바뀌었습니다. 내용을 대조하고 다시 확정하세요.</p>':'')+'<div class=\"toolbar\"><button data-action=\"review-student\" data-value=\"'+x.id+'\">마감·리포트 검토</button><a class=\"button\" href=\"'+notebookLink(x.id,'review')+'\" target=\"_blank\" rel=\"noopener\">학원 일지 대조·입력 ↗</a>'+(d?.reportChecked&&r.current?'<button data-action=\"copy-parent\" data-value=\"'+x.id+'\">학부모 문안 복사</button>':'')+'</div></section>';}).join('')||'<p class=\"note\">이 범위의 예정·마감 학생이 없습니다.</p>');}\nfunction reviewFacts(d){return '<dl class=\"facts\"><dt>실제 진도</dt><dd>'+esc(d.progress)+'</dd><dt>다음 숙제</dt><dd>'+esc(d.noHomework?'없음으로 확인':d.homework+' · 기한 '+d.due)+'</dd><dt>다음 확인</dt><dd>'+esc(d.next||'기록 없음')+'</dd></dl>'+(d.diary?'<details><summary>검토된 학원 공개 일지 · Sheet 보관</summary><p>진도: '+esc(d.diary.progress)+'</p><p>숙제: '+esc(d.diary.homework)+'</p><p>메모: '+esc(d.diary.classMemo||'기존 학원 메모 유지')+'</p><p>학원 DB 입력·리포트 저장·발송은 별도 확인합니다.</p></details>':'');}\nfunction draftsView(drafts){return '<section class=\"panel\"><div class=\"panelhead\"><h3>'+drafts.length+'건 · 원본 저장 전</h3><button data-action=\"backup-all\">입력 파일 보관</button></div><p class=\"hint\">이 브라우저의 임시 입력입니다. 원본 저장을 마치면 해당 입력은 비워집니다.</p>'+drafts.map(d=>'<div class=\"draft-list\"><div><b>'+esc(data.students.find(s=>s.id===d.context.studentId)?.name||d.context.studentId)+'</b> · '+esc(d.context.date)+'<br><span class=\"small\">'+esc(formTitle(d.context.kind))+' · '+esc(data.catalog.books.find(b=>b.id===d.context.bookId)?.name||'학생별 기록')+(d.pending?' · 저장 여부 확인 필요':'')+'</span></div><button data-action=\"resume\" data-value=\"'+esc(PTFlow.key(d.context))+'\">이어서 작성</button></div>').join('')+(drafts.length?'':'<p class=\"empty\">작성 중인 입력이 없습니다.</p>')+'</section>';}\nfunction importPanel(){return '<section class=\"panel\"><h3>아이폰에서 확정한 진도·숙제</h3><p class=\"hint\">아이폰의 귀가 전 확정 또는 수업 후 검토에서 ‘Tracker 전달 내용 복사’를 누른 뒤 붙여 넣으세요.</p><label for=\"handoff-input\">전달 내용</label><textarea id=\"handoff-input\" rows=\"5\">'+esc(handoffRaw)+'</textarea><p id=\"handoff-status\" class=\"hint\">학생 한 명 · 수업 한 번의 확정 내용만 반영합니다.</p><div class=\"toolbar\"><button data-action=\"parse-import\">학생·날짜 확인</button><button data-action=\"cancel-form\">닫기</button></div>'+(handoffPreview?'<div class=\"line\"></div><h3>'+esc(handoffPreview.studentName)+' · '+esc(handoffPreview.date)+'</h3>'+reviewFacts(handoffPreview.closeout)+'<p class=\"notice\">저장된 마감이 있으면 기존 내용과 함께 대조합니다. 진도 완료율과 출결은 자동 변경하지 않습니다.</p><button class=\"primary\" data-action=\"accept-import\">이 학생의 마감 입력으로 가져오기</button>':'')+'</section>';}\n\nfunction bookTabs(s){return '<div class=\"booktabs\">'+s.books.map(b=>'<button data-action=\"book\" data-value=\"'+esc(b.book.id)+'\" class=\"'+(b.book.id===book()?.book.id?'selected':'')+'\">교재 '+b.assignment.slot+' · '+esc(b.book.name)+'</button>').join('')+'</div>';}\nfunction stacked(b){if(b.ratio==null)return '<div class=\"bar unknown\" aria-label=\"완료 범위 미확인\"></div>';let t=b.total||1;return '<div class=\"bar\" aria-label=\"교사 확인 완료 '+pct(b.ratio)+'\">'+[['확인완료','confirm'],['확인대기','wait'],['오답보완','review'],['학습중','working'],['과제','working']].map(x=>'<span class=\"seg '+x[1]+'\" style=\"width:'+((b.counts[x[0]]||0)/t*100)+'%\"></span>').join('')+'</div>';}\nfunction metrics(b){return '<div class=\"metrics\"><div class=\"metric\"><div class=\"label\">페이지 확인 완료율</div><div class=\"value\">'+pct(b.ratio)+'</div>'+stacked(b)+'<div class=\"small\">'+(b.total?(b.hasEvidence?b.confirmed+'쪽 확인 / ':'')+b.total+'쪽 · 잠정 기준':'집계 범위 미확인 · '+(b.confirmed?b.confirmed+'쪽 확인':'진도 기록 가능'))+'</div></div><div class=\"metric\"><div class=\"label\">목차 단원 완료율</div><div class=\"value\">'+pct(b.unitRatio)+'</div><div class=\"small\" style=\"margin-top:13px\">'+(b.unitTotal?(b.hasEvidence?b.unitsDone:'—')+' / '+b.unitTotal+(b.flat.some(u=>u.kind==='PAGE_GROUP')?'개 공동 범위':'개 학습 단원'):'단원 기준 미등록')+'</div></div><div class=\"metric\"><div class=\"label\">대단원 완료</div><div class=\"value\">'+(b.hasEvidence?b.chaptersDone:'—')+' <span class=\"suffix\">/ '+(b.chaptersTotal||'—')+'</span></div><div class=\"small\" style=\"margin-top:13px\">대단원 안의 활동·TEST 확인 포함</div></div></div>';}\nfunction focus(b){const u=b.flat.find(x=>x.id===b.focus.unitId);return '<div class=\"focus\"><div><span class=\"small\">'+(b.history.length?'최근 수업 위치':'준비된 시작 위치')+'</span><strong>'+esc(u?.name||b.focus.detail||'수업 시작 범위를 입력해 주세요')+(b.focus.page?' · '+b.focus.page+'쪽':'')+'</strong><p>'+esc(b.last?.data.nextAction||b.focus.detail||'학생별 기록을 시작하면 다음 할 일이 여기에 모입니다.')+'</p></div><button class=\"primary\" data-action=\"progress\" data-value=\"'+esc(b.focus.unitId)+'\">기록하기</button></div>';}\nfunction legend(){return '<div class=\"legend\"><span><i style=\"background:#0e8c80\"></i>확인완료</span><span><i style=\"background:#84abc9\"></i>확인대기</span><span><i style=\"background:#e0a453\"></i>오답보완</span><span><i style=\"background:#acbac0\"></i>미확인·미시작</span></div>';}\nfunction unitRow(u,b){\n if(u.kind==='TOPIC')return '<div class=\"unit subunit topic\"><div class=\"name\"><strong>'+esc(u.name)+'</strong><span class=\"small\">위 공동 범위에 포함 · 개별 쪽수 미확인</span></div><button data-action=\"subunit\" data-value=\"'+esc(u.id)+'\" aria-label=\"'+esc(u.name)+' 개별 범위 설정\">범위</button></div>';\n const extra=u.kind==='PAGE_GROUP'?'공동 범위 · ':u.kind==='CHALLENGE'?'생각근육 · ':u.kind==='REVIEW_ACTIVITY'?'마무리 활동 · ':'';\n return '<div class=\"unit '+(['TEST','CHALLENGE','REVIEW_ACTIVITY'].includes(u.kind)?'test ':'')+(u.level===3?'subunit ':'')+(u.id===b.focus.unitId?'focusunit':'')+'\"><span class=\"statusdot '+(u.done?'done':u.ratio!=null?'started':'')+'\"></span><div class=\"name\"><strong>'+esc(u.name)+'</strong><span class=\"small\">'+extra+(u.start?u.start+'–'+(u.end||'?')+'쪽':'범위 미정')+' · '+(u.done?'교사 확인 완료':u.end==null?'끝 페이지 미정':u.unknown?'확인 기록 없음':u.confirmed+'/'+u.eligible+'쪽 확인')+'</span></div><button data-action=\"progress\" data-value=\"'+esc(u.id)+'\">기록</button>'+(u.level===3?'<button data-action=\"subunit\" data-value=\"'+esc(u.id)+'\">범위</button>':'')+(u.level===2&&['UNIT','PAGE_GROUP'].includes(u.kind)?'<button data-action=\"subunit\" data-value=\"'+esc(u.id)+'\" aria-label=\"'+esc(u.name)+' 세부 단원 추가\">＋</button>':'')+'</div>'+u.children.map(x=>unitRow(x,b)).join('');\n}\nfunction unitTree(b){if(!b.tree.length)return '<div class=\"empty\">이 교재의 목차를 받으면<br>페이지·단원 완료율을 함께 표시합니다.<br>현재 진도와 과제는 먼저 기록할 수 있습니다.</div>';return (b.flat.some(u=>u.kind==='PAGE_GROUP')?'<div class=\"note\" style=\"margin-bottom:12px\">공동 범위 아래의 세부 내용은 같은 쪽수에 포함됩니다. 개별 쪽수를 확인하기 전까지 공동 범위로 기록하고 집계합니다.</div>':'')+b.tree.map((u,i)=>u.kind!=='CHAPTER'?'<div class=\"chapter\">'+unitRow(u,b)+'</div>':'<details class=\"chapter\"'+(u.children.some(x=>x.id===b.focus.unitId)||i===0?' open':'')+'><summary><span class=\"title\">'+esc(u.name)+'</span><span class=\"tag '+(u.done?'teal':'')+'\">'+(u.done?'완료':u.unknown?'미확인':pct(u.ratio))+'</span></summary>'+u.children.map(x=>unitRow(x,b)).join('')+'</details>').join('');}\nfunction history(b){const h=b.history.slice(0,15);if(!h.length)return '<div class=\"empty\">아직 저장된 학습 기록이 없습니다.<br>오늘 기록부터 차곡차곡 쌓입니다.</div>';return h.map(e=>'<div class=\"history\"><time>'+esc(e.date)+'</time><strong>'+esc(e.data.detail||(e.data.start?e.data.start+'–'+(e.data.end||'?')+'쪽':'학습 기록'))+' <span class=\"tag '+(e.data.status==='확인완료'?'teal':e.data.status==='오답보완'?'amber':'')+'\">'+esc(e.data.status)+'</span></strong>'+(e.data.homework?'<p>숙제 확인 기록 · '+esc(e.data.homework)+' ('+esc(e.data.homeworkStatus)+')</p>':'')+(e.data.evaluation?'<p>확인 · '+esc(e.data.evaluation)+'</p>':'')+(e.data.unresolved?'<p><span class=\"tag amber\">미해결</span> '+esc(e.data.unresolved)+'</p>':'')+((e.data.attempted||e.data.marked||e.data.corrected||e.data.materials||e.data.inspected||e.data.feedback)?'<details><summary>시도·점검·피드백</summary>'+[['attempted','시도'],['marked','채점'],['corrected','오답 재확인'],['materials','점검 자료']].filter(([k])=>e.data[k]).map(([k,label])=>'<p>'+label+' · '+esc(e.data[k])+'</p>').join('')+'<p>자료 점검 '+(e.data.inspected?'마침':'미기록')+' · 피드백 전달 '+(e.data.feedback?'마침':'미기록')+'</p></details>':'')+(e.data.intent==='correction'?'<p>정정 이유 · '+esc(e.data.reason)+'</p>':'')+(e.data.nextAction?'<p><b>다음 · '+esc(e.data.nextAction)+'</b></p>':'')+'</div>').join('');}\nfunction studentAttendance(s){const a=data.attendance.filter(x=>x.studentId===s.id).slice().reverse().slice(0,3),m=data.makeups.filter(x=>x.studentId===s.id&&x.status!=='취소');return (a.length?a.map(x=>'<div class=\"listrow\"><div>'+esc(x.date)+' · '+esc(x.status)+'<div class=\"small\">'+esc(x.reason)+'</div></div></div>').join(''):'<div class=\"small\">출결 기록 없음</div>')+(m.length?m.map(x=>'<div class=\"listrow\"><div>'+esc(x.date||'날짜 미정')+' '+esc(x.start)+'<div class=\"small\">'+esc(x.range)+'</div></div><span class=\"tag '+(x.status==='후보'?'amber':'teal')+'\">'+esc(x.status)+'</span></div>').join(''):'<div class=\"small\" style=\"margin-top:8px\">보강 일정 없음</div>');}\nfunction calendarView(s){const now=new Date(classDate+'T12:00:00Z'),y=now.getUTCFullYear(),m=now.getUTCMonth(),first=new Date(Date.UTC(y,m,1)).getUTCDay(),count=new Date(Date.UTC(y,m+1,0)).getUTCDate();let days='';for(let i=0;i<first;i++)days+='<div></div>';for(let d=1;d<=count;d++){const iso=y+'-'+String(m+1).padStart(2,'0')+'-'+String(d).padStart(2,'0');days+='<div class=\"calday '+(iso===data.today?'today':'')+'\"><strong>'+d+'</strong>'+data.makeups.filter(x=>x.date===iso&&x.status!=='취소').map(x=>'<span class=\"event '+(x.status==='후보'?'candidate':'')+'\">'+esc(x.name)+' '+esc(x.start)+'<br>'+esc(x.status)+'</span>').join('')+'</div>';}\n return '<section class=\"panel calendar-panel\"><div class=\"panelhead\"><div><h2>'+y+'년 '+(m+1)+'월</h2><div class=\"small\">전체 학생의 보강 · 점선은 미확정 후보</div></div><div class=\"toolbar\"><button data-action=\"month\" data-value=\"-1\" aria-label=\"이전 달\">‹</button><button data-action=\"month\" data-value=\"1\" aria-label=\"다음 달\">›</button><button data-action=\"makeup\">보강 일정 기록</button></div></div><div class=\"calgrid\">'+['일','월','화','수','목','금','토'].map(d=>'<div class=\"dow\">'+d+'</div>').join('')+days+'</div></section>'+(formKind?formPanel(s,book()):'<section class=\"panel\"><h3>보강 기록</h3>'+(data.makeups.length?data.makeups.map(x=>'<div class=\"listrow\"><div><b>'+esc(x.name)+'</b> · '+esc(x.date||'날짜 미정')+' '+esc(x.start)+'–'+esc(x.end)+'<div class=\"small\">'+esc(x.range)+' · '+esc(x.memo)+'</div></div><div><span class=\"tag '+(x.status==='후보'?'amber':'teal')+'\">'+esc(x.status)+'</span> <button data-action=\"makeup-edit\" data-value=\"'+esc(x.id)+'\">수정</button></div></div>').join(''):'<div class=\"empty\">등록된 보강 기록이 없습니다.</div>')+'</section>');}\nfunction settingsView(s,b){return '<section class=\"panel\"><div class=\"panelhead\"><div><h2>'+esc(b.book.name)+'</h2><div class=\"small\">'+esc(s.name)+' · '+esc(b.book.code||'분권 표기 미확인')+'</div></div></div>'+bookTabs(s)+'<div class=\"note\">목차에 명시된 페이지를 우선 사용합니다. 시작 쪽만 있는 항목은 다음 시작 쪽 직전까지 잠정 집계하며, 마지막 쪽은 확인 전까지 미정으로 둡니다.</div>'+metrics(b)+'<div class=\"row\"><button data-action=\"exclusions\"'+(!b.total?' disabled':'')+'>제외 페이지 조정</button><button data-action=\"baseline\">이전 완료 범위 확인</button></div></section>'+(formKind?formPanel(s,b):'<section class=\"panel\"><div class=\"panelhead\"><div><h3>목차와 세부 단원</h3><div class=\"small\">학습 단원 오른쪽 ＋로 세부 단원을 추가합니다.</div></div></div>