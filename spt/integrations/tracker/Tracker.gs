 }catch(error){SpreadsheetApp.getActive().toast('보강 저장이 완료되지 않았습니다: '+error.message,'확인 필요',10);throw error;}finally{SpreadsheetApp.flush();lock.releaseLock();}
}
function onEdit(e){
 if(!e||!e.range)return;const name=e.range.getSheet().getName();const allowed=['박경찬',PK_OPS.HOME,PK_OPS.TODAY,PK_OPS.STUDENTS,PK_OPS.CALENDAR,PK_OPS.SESSION_DB,PK_OPS.ATTENDANCE_DB,PK_OPS.LEARNING_DB,PK_OPS.MAKEUP_DB];if(!allowed.includes(name))return;
 const lock=LockService.getScriptLock();
 try{if(!lock.tryLock(1500))throw new Error('다른 저장 중 편집 이벤트가 발생해 자동 감사되지 않았습니다. Google 버전기록을 확인하세요.');
  if(name===PK_OPS.TODAY&&e.range.getLastRow()>=10&&e.range.getRow()<=39&&e.range.getLastColumn()>=5){const start=Math.max(10,e.range.getRow()),end=Math.min(39,e.range.getLastRow());e.range.getSheet().getRange(start,1,end-start+1,1).setValue(false);}
  const old=Object.prototype.hasOwnProperty.call(e,'oldValue')?e.oldValue:'[이전값 미제공: 다중셀/구조 편집은 Google 버전기록에서 확인]';
  pkAppendLog_('사용자편집',name,e.range.getA1Notation(),'셀',old,pkJson_({values:e.range.getValues(),formulas:e.range.getFormulas()}),'직접 편집 이벤트; API·스크립트 편집은 별도 기록','이벤트기록','','사용자');
 }catch(error){SpreadsheetApp.getActive().toast('감사 확인 필요: '+error.message,'박경찬 운영',10);throw error;}finally{SpreadsheetApp.flush();lock.releaseLock();}
}
function pkEnsureSessionsForDate_(date) {
  const students = pkSheet_(PK_OPS.STUDENTS).getRange('B14:J113').getValues();
  const weekday = ['일', '월', '화', '수', '목', '금', '토'][date.getDay()];
  const seen = {};
  students.forEach(row => {
    const status = String(row[0] || '');
    const className = String(row[4] || '');
    const part = String(row[5] || '');
    const days = String(row[6] || '');
    const firstDate = row[8];
    if (status !== '재원' || !className || !part || !days.includes(weekday)) return;
    if (firstDate instanceof Date && pkDateOnly_(firstDate) > date) return;
    const key = className + '|' + part;
    if (!seen[key]) {
      pkEnsureSession_(date, className, part);
      seen[key] = true;
    }
  });
}

function pkEnsureSession_(date,className,part){
 const id=pkSessionId_(date,className,part),db=pkRows_(PK_OPS.SESSION_DB,12),existing=db.filter(r=>r[0]===id);if(existing.length>1)throw new Error('수업ID 중복: '+id);if(existing.length)return id;
 const time=pkTimes_(className,part),day=pkDay_(date),weekday=['일','월','화','수','목','금','토'][new Date(day+'T12:00:00+09:00').getUTCDay()];
 const record=[id,date,weekday,className,part,time[0],time[1],'진행','선택날짜',new Date(),'','Apps Script'];pkUpsert_(PK_OPS.SESSION_DB,id,record,'수업생성',id);return id;
}
function pkEnsureMakeupQueue_(attendanceId,studentId,studentName,absenceDate,reason,consult){
 const s=pkSheet_(PK_OPS.CALENDAR),rows=s.getRange('A22:K121').getValues();if(rows.some(r=>r[0]===attendanceId))return;
 const at=rows.findIndex(r=>!r[0]&&!r[1]);if(at<0)throw new Error('보강 입력표가 가득 찼습니다.');
 const out=[attendanceId,studentName,absenceDate,reason,consult,'','','미확정','후보','학부모 상담 후 일정 확정',''];
 pkAppendLog_('보강후보입력예정',PK_OPS.CALENDAR,'A'+(at+22)+':K'+(at+22),'후보행',pkJson_(rows[at]),pkJson_(out),'실제 출결ID 연결','처리중',studentId,'자동화');
 s.getRange(at+22,1,1,11).setValues([out.map(pkLiteral_)]);
}
function pkUpsert_(name,id,record,type,target){
 const s=pkSheet_(name),db=pkRows_(name,record.length),matches=db.map((r,i)=>r[0]===id?i:-1).filter(i=>i>=0);if(matches.length>1)throw new Error('중복 레코드ID: '+id);
 const index=matches.length?matches[0]:db.length,before=matches.length?db[index]:null,row=index+2,out=pkMergedRecord_(name,before,record);
 pkAppendLog_(type+'예정',name,'A'+row,'레코드',pkJson_(before),pkJson_(out),'복원 가능한 전체 payload','처리중',target,'자동화');
 const fresh=s.getRange(row,1,1,record.length).getValues()[0];if(before?pkJson_(fresh)!==pkJson_(before):fresh.some(v=>v!==''))throw new Error('저장 대상이 변경되었습니다: '+id);
 s.getRange(row,1,1,out.length).setValues([out.map(pkLiteral_)]);SpreadsheetApp.flush();
 const actual=s.getRange(row,1,1,out.length).getValues()[0];if(pkJson_(actual)!==pkJson_(out))throw new Error('저장 후 값이 일치하지 않습니다: '+id);
 pkAppendLog_(type+'완료',name,'A'+row,'레코드',pkJson_(before),pkJson_(actual),'저장 후 조회 일치','확인',target,'자동화');
}
function pkAppendLog_(type,name,range,field,before,after,reason,status,note,actorType){
 const audit=pkSheet_(PK_OPS.AUDIT_DB),now=new Date(),id='LOG-'+Utilities.getUuid(),a=pkClip_(before),b=pkClip_(after),limit=30000,n=Math.max(1,Math.ceil(a.length/limit),Math.ceil(b.length/limit));
 const rows=Array.from({length:n},(_,i)=>[id+'-'+(i+1),now,pkActor_(),actorType||'자동화','미수집 (Apps Script)',type,name,range,field,a.slice(i*limit,(i+1)*limit),b.slice(i*limit,(i+1)*limit),reason,status,String(note||'')+' | payload '+(i+1)+'/'+n+'; before='+a.length+'; after='+b.length]);
 const start=audit.getLastRow()+1;audit.getRange(start,1,rows.length,14).setValues(rows.map(r=>r.map(pkLiteral_)));SpreadsheetApp.flush();
 if(audit.getRange(start,1,rows.length,1).getValues().some((r,i)=>r[0]!==rows[i][0]))throw new Error('감사 기록 확인 실패. 저장 완료로 간주하지 마세요.');
}
function pkNextStudentId_(sheet) {
  const ids = sheet.getRange('A14:A113').getDisplayValues().flat();
  const max = ids.reduce((m, id) => {
    const match = String(id).match(/^S(\d+)$/);
    return match ? Math.max(m, Number(match[1])) : m;
  }, 0);
  return 'S' + String(max + 1).padStart(3, '0');
}

function pkTimes_(className, part) {
  if (part === '1부') return className === '화목반' ? ['15:00', '18:00'] : ['15:00', '17:30'];
  return className === '화목반' ? ['18:30', '22:00'] : ['18:30', '21:30'];
}

function pkDateOnly_(date) {
  const d = new Date(date);
  d.setHours(0, 0, 0, 0);
  return d;
}

function pkActor_(){return Session.getActiveUser().getEmail()||'편집자 미확인';}
function pkClip_(value){return value instanceof Date?value.toISOString():String(value===null||value===undefined?'':value);}
function pkSheet_(name) {
  const ss=SpreadsheetApp.getActive();
  if(ss.getId()!=='1R8DoOOo5yg3M1hgHPA0Vuqp3Ng-K5bQgxdiy5dEeXOg')throw new Error('허용된 원본 파일이 아닙니다.');
  const allowed=[PK_OPS.HOME,PK_OPS.TODAY,PK_OPS.STUDENTS,PK_OPS.CALENDAR,PK_OPS.SESSION_DB,PK_OPS.ATTENDANCE_DB,PK_OPS.LEARNING_DB,PK_OPS.MAKEUP_DB,PK_OPS.AUDIT_DB,'박경찬'];
