);else if(a==='exclusions')openForm('exclusions');\n else if(a==='review-form')openForm('review');else if(a==='review-student'){if(!allowNavigation())return;closeForm();studentId=v;bookId=student().books[0]?.book.id||'';openForm('review');}\n else if(a==='makeup'||a==='makeup-edit'){if(!allowNavigation())return;closeForm();editMakeup=a==='makeup-edit'?v:'';openForm('makeup');}\n else if(a==='reload'){if(data)await reloadView();else await load();}\n else if(a==='cancel-form'){if(!allowNavigation())return;closeForm();render();}\n else if(a==='roster-scope'){if(!allowNavigation())return;closeForm();rosterScope=rosterScope==='scheduled'?'all':'scheduled';render();}\n else if(a==='resume')resumeDraft(v);\n else if(a==='retry-save')await saveForm();else if(a==='check-request')await checkRequest();\n else if(a==='rebase'){if(!$('#rebase-check')?.checked){toast('최신 원본과 내 입력을 대조한 뒤 체크해 주세요.');return;}formValues=collectValues();formContext.revision=currentRevision(formContext);formContext.evidenceBasis=factsBasis(formContext.studentId,formContext.date);formContext.base=currentSnapshot(formContext);comparison=false;formError='';pending=null;if(formKind==='review'){formValues.confirmed=false;formValues.reportChecked=false;formValues.transferredAt=false;}dirty=true;persistDraft();render();}\n else if(a==='backup-current'){formValues=collectValues();if(!formContext)return;downloadDrafts([{context:formContext,values:formValues,pending,version:draftVersion,updated:new Date().toISOString()}]);}\n else if(a==='save-after-backup'){if(comparison||pending){toast('최신 원본 또는 보낸 요청부터 대조해 주세요.');return;}formValues=collectValues();downloadDrafts([{context:formContext,values:formValues,pending:null,version:draftVersion,updated:new Date().toISOString()}]);await saveForm(undefined,true);}\n else if(a==='backup-all')downloadDrafts(readDrafts());\n else if(a==='load-other-draft'){if(!window.confirm('현재 화면의 입력은 먼저 파일로 보관하세요. 다른 창에서 보관한 입력을 불러올까요?'))return;const k=PTFlow.key(formContext);closeForm()