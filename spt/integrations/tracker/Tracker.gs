function pkSaveMakeupQueue(){
 const lock=LockService.getScriptLock();lock.waitLock(10000);
 try{const s=pkSheet_(PK_OPS.CALENDAR),rows=s.getRange('A22:K121').getValues(),db=pkRows_(PK_OPS.MAKEUP_DB,15),parents=pkRows_(PK_OPS.ATTENDANCE_DB,14),plans=[];
  const stableIds=rows.filter(r=>r[10]).map(r=>r[10]);if(new Set(stableIds).size!==stableIds.length)throw new Error('보강ID가 중복되었습니다. 분할 보강은 새 행으로 등록하세요.');
  rows.forEach((r,i)=>{if(!r[0]&&!r[1])return;plans.push({i,row:r,...pkPlanMakeup_(r,db,parents)});});
