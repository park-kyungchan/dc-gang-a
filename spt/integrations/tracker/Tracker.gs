 const prior=pkRows_(PK_OPS.LEARNING_DB,16).filter(r=>r[1]===sessionId&&r[3]===studentId&&r[5]===book);if(prior.length>1)throw new Error('학생·교재 학습 기록이 중복되었습니다.');
 const id=prior.length?prior[0][0]:'LRN-'+sessionId+'-'+studentId+'-'+pkHash_(book).slice(0,12),now=new Date();
 pkUpsert_(PK_OPS.LEARNING_DB,id,[id,sessionId,lessonDate,studentId,studentName,book,prior[0]?prior[0][6]:'',progress,homework,homeworkStatus,evaluation,nextAction,memo,now,now,actor],'학습저장',studentId);
